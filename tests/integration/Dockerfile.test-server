# syntax=docker/dockerfile:1.4
#
# tests/integration/Dockerfile.test-server
#
# Pre-baked FTPS test server image for the scenarios in
# tests/integration/scenarios/ (specifically 03-ftps-explicit-upload
# and 04-ftps-implicit-upload, which source
# tests/integration/lib/self-signed-cert.sh).
#
# Build with:
#   make build-test-server-image TEST_SERVER_IMAGE=ftp-deployment-action-test-server:ci-integration
#
# Why this image exists (closes #135):
#   The original start_ftps_server booted `alpine:3.23.3 -c 'apk add
#   --no-cache vsftpd && ...'` on every scenario run. The `apk add`
#   step downloads the alpine package index from the network, which
#   made scenario 03 and 04 flaky in CI (ubuntu-latest, GitHub
#   Actions):
#     * apk index download took 1-15s and occasionally exceeded the
#       wait_for_port deadline (20s).
#     * on a transient network blip, apk failed outright; the
#       container then died and was garbage-collected by --rm,
#       surfacing as "No such container" in the harness.
#   Pre-baking vsftpd into a dedicated image eliminates the per-run
#   network dependency: the scenario only does `docker run` against
#   an already-pulled image, which takes <1s to start and never races
#   the apk index.
#
# Base image: alpine:3.24, digest-pinned to the same value the action
# Dockerfile uses (Dockerfile:1). Aligned to 3.24 (not the 3.23 the
# inline `apk add` originally targeted) because:
#   * the action image is already on 3.24; building both off the
#     same digest means CI rebuilds only one base and the local
#     dev / CI parity check is trivial (same digest == same
#     contents, by definition).
#   * keeping the test server on 3.23 would have made any future
#     3.24-vs-3.23 libssl/glibc-compat diff impossible to debug
#     (which side diverged?). Pin both to 3.24 and the question
#     goes away.
# Bump this digest in lockstep with Dockerfile:1.
#
# Packages installed at build time (hadolint DL3018 — versions
# pinned, same pattern the action Dockerfile uses):
#   * vsftpd   — the FTP/FTPS daemon the scenarios exercise.
#                vsftpd pulls libssl as a package dep, which is
#                all the FTPS server image needs at runtime; we
#                intentionally do NOT install the openssl CLI
#                because the per-run self-signed cert is generated
#                on the host (in tests/integration/lib/self-signed-
#                cert.sh via `openssl req`), never inside the
#                container. Keeping the server image openssl-free
#                drops ~5 MB and one piece of unused attack
#                surface.
#   * lftp + ca-certificates (v2.11.3 / #136) — the lftp client
#                used by lftp_run_script (tests/integration/lib/
#                common.sh:286). Pre-baking them eliminates the
#                apk-index race the inline `apk add --no-cache lftp`
#                inside every integration container was hitting
#                (same class as #135 for the FTPS server, same class
#                as #137 for the smoke suite). Versions pinned to
#                match the action Dockerfile (4.9.3-r0 /
#                20260611-r0) so the integration scenarios exercise
#                the same lftp the user gets.
#
# Filesystem prep (moved out of the per-scenario -c payload into
# the image, because they are CONSTANT across every scenario run):
#   * /etc/pam.d                — alpine's busybox base does NOT ship
#                                 this directory (only /etc exists).
#                                 The vsftpd package's post-install
#                                 hook creates /etc/pam.d/vsftpd but
#                                 we are using the vsftpd `pre-install`
#                                 trigger path that does NOT create
#                                 the dir; the printf redirection below
#                                 needs it to exist. (Pre-fix #149
#                                 removed this mkdir as a "no-op"; CI
#                                 caught the breakage: the configuration
#                                 write failed with "nonexistent
#                                 directory". Restored.)
#   * /var/log/vsftpd           — vsftpd's xferlog target
#                                 (xferlog_file=/var/log/vsftpd/
#                                 vsftpd.log in the overlay conf).
#   /home/vsftpd is NOT pre-created in this image: the
#   per-scenario `docker run` carries `-v ${FTP_DATA_DIR}:/home/vsftpd`,
#   so the in-container /home/vsftpd is the host's bind mount, not a
#   build-time artefact. docker / podman auto-create the mountpoint on
#   the IMAGE side if it does not exist, so a build-time mkdir here
#   would be overwritten by the bind mount. Keeping the comment out of
#   the prep list is intentional (see #149).
#
# The per-scenario startup still does the user-specific work (create
# the FTP user, write the overlay vsftpd.conf with the per-scenario
# SSL/PASV settings, exec vsftpd). See start_ftps_server in
# tests/integration/lib/self-signed-cert.sh.
#
# Why # syntax=docker/dockerfile:1.4: this file is built with the
# BuildKit Dockerfile frontend used by the Makefile. Pinning the frontend
# keeps parsing unambiguous on every supported Docker version.

FROM alpine@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b

RUN set -eu; apk add --no-cache \
      vsftpd=3.0.5-r3 \
      lftp=4.9.3-r0 \
      ca-certificates=20260611-r0 \
 && mkdir -p /etc/pam.d /var/log/vsftpd \
 && printf '%s\n' \
      'auth required pam_unix.so' \
      'account required pam_unix.so' \
      'session required pam_unix.so' \
      > /etc/pam.d/vsftpd_virtual
