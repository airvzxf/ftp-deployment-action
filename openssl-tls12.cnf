# openssl-tls12.cnf — OpenSSL config for lftp when tls_max_version is
# "1.2" (the default). entrypoint.sh points OPENSSL_CONF here.
#
# Why (#361): lftp 4.9.3 closes a TLS 1.3 data connection without
# reading the session tickets the server sends after the handshake.
# The kernel then resets the connection and drops what lftp had not
# sent yet: its close_notify and, on a real network, the tail of the
# file. The server replies "426 Failure reading network stream." and
# keeps a truncated file. In TLS 1.2 the tickets are part of the
# handshake, so nothing is left unread.
#
# lftp's own `ssl:priority` setting has no effect on its OpenSSL
# build, so the cap is set here. Without a providers section OpenSSL
# loads its default provider, as it does with no config at all.
openssl_conf = openssl_init

[openssl_init]
ssl_conf = ssl_sect

[ssl_sect]
system_default = system_default_sect

[system_default_sect]
MaxProtocol = TLSv1.2
